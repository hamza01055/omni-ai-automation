# ─────────────────────────────────────────────────────────────
# OmniAI Automation — copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

APP_ENV=development           # development | staging | production
LOG_LEVEL=INFO
TZ=UTC

# ── Database & cache ────────────────────────────────────────
POSTGRES_USER=omni
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=omni
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://omni:change_me_locally@postgres:5432/omni
REDIS_URL=redis://redis:6379/0

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Encrypts channel_credentials at rest (Fernet key, 32 url-safe base64 bytes):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Shared bearer token n8n uses on /api/internal/* — not a user credential.
INTERNAL_SERVICE_TOKEN=

# ── Ports / URLs ────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_API_BASE_URL=http://localhost:8000

# ── AI ──────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Human-in-the-loop thresholds (see docs/architecture.md §Confidence)
AI_AUTO_REPLY_THRESHOLD=0.90
AI_REVIEW_THRESHOLD=0.70

# ── n8n ─────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=
N8N_DB_NAME=n8n

# ── Channels ────────────────────────────────────────────────
# Leave blank to run that channel through its mock adapter.
# Setup instructions: docs/integrations.md

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Meta (shared by Instagram + Facebook)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# X / Twitter API v2
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=
X_WEBHOOK_SECRET=
